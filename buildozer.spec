[app]

title = Rasta Studio APK Proof
package.name = rastastudioproof
package.domain = org.rasta

source.dir = .
source.include_exts = py,png,jpg,kv,atlas

version = 1.0.0

requirements = python3,kivy

orientation = portrait

android.api = 35
android.minapi = 29
android.archs = armeabi-v7a

android.permissions = INTERNET


[buildozer]

log_level = 2
warn_on_root = 1
